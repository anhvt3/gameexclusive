{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "cd app && npm run build",
  "outputDirectory": "app/dist",
  "installCommand": "cd app && npm install && cd ../api && npm install",
  "framework": null,
  "regions": ["sin1"],
  "functions": {
    "api/**/*.ts": {
      "runtime": "@vercel/node@5.1.0",
      "maxDuration": 10,
      "memory": 256
    }
  },
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, max-age=0" }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/cron/cleanup-nonces",
      "schedule": "0 3 * * *"
    }
  ]
}
