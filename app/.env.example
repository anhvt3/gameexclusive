# Phase 5 — Frontend env vars (Vite import.meta.env.VITE_*)
# Copy to `.env.local` (gitignored) and fill in real values for local dev.

# ── Backend ─────────────────────────────────────────────────────────
# Base URL for Vercel Serverless Functions (no trailing slash).
#   Dev:        http://localhost:3000      (vercel dev)
#   UAT:        https://<branch>.gameexclusive.vercel.app
#   Production: https://game.clevai.edu.vn
VITE_API_BASE=http://localhost:3000

# Rollback flag — set false to revert to Phase 4 local-only behavior
# (no SaveSyncEngine POST, no /api/telemetry, no /api/{shop,breed}/validate).
VITE_BACKEND_ENABLED=true

# HMAC secret — MUST match PHASE5_VALIDATION_SECRET on backend side.
# Phase 5: shared literal. Phase 6: rotate per release via Vercel env.
VITE_PHASE5_VALIDATION_SECRET=phase5-game-ss3-validation-secret-v1

# ── Observability ───────────────────────────────────────────────────
VITE_AMPLITUDE_API_KEY=
VITE_SENTRY_DSN=
VITE_SENTRY_RELEASE=
